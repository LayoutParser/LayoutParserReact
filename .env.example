# Copie para .env (ou .env.local, que ja e ignorado pelo git) e ajuste os valores.
# Para o dia a dia normalmente NAO e preciso criar .env: .env.development e .env.production
# ja cobrem `npm run dev` e os builds.

# Deixe vazio para o fluxo same-origin: `/api` cai no proxy do Vite em dev e no gateway
# Node/IIS em builds estáticos. A origem da API .NET é configurada no BFF (`server/.env`).
VITE_API_BASE_URL=

# Limite cliente em MiB (1..100). Gateway/API precisam aplicar o limite autoritativo.
VITE_MAX_UPLOAD_MB=25

# O proxy do Vite encaminha `/api` ao BFF Node. A API .NET é configurada em `server/.env`.
VITE_DEV_BFF_PROXY_TARGET=http://127.0.0.1:3100

# Identidade de demonstração local, injetada pelo proxy do Vite e aceita somente em development.
# Não use nomes reais nem segredos aqui.
VITE_DEV_BFF_USER=layoutparser.local
VITE_DEV_BFF_ROLES=LayoutParserAdmins
