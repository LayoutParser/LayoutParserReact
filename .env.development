# Carregado pelo Vite em `npm run dev` e nos builds com `--mode development`.
# O navegador usa sempre `/api`; Vite/IIS encaminham ao BFF Node, que alcança a API .NET.
VITE_API_BASE_URL=

VITE_MAX_UPLOAD_MB=25

# O Vite fala com o gateway Node, e nunca diretamente com a API .NET.
VITE_DEV_BFF_PROXY_TARGET=http://127.0.0.1:3100

# Identidade local não sensível, aceita apenas pelo BFF em modo development.
# Produção ignora e proíbe o mecanismo de impersonação de desenvolvimento.
VITE_DEV_BFF_USER=layoutparser.local
VITE_DEV_BFF_ROLES=LayoutParserAdmins
