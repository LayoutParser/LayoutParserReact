{
  "//": "Template recomendado do harness. Para ativar: copie para .claude/settings.json",
  "//language": "Responde ao usuario em portugues.",
  "language": "portuguese",

  "//permissions": "Allowlist de comandos seguros para reduzir prompts. Ajuste a vontade.",
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run preview:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run format:*)",
      "Bash(npx tsc:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Read",
      "Grep",
      "Glob"
    ]
  },

  "//hooks": "Guardas deterministicas de caminho + feedback rapido. Todos usam Node e funcionam no Windows.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.CLAUDE_PROJECT_DIR || process.cwd(), '.claude', 'hooks', 'protect-sensitive-paths.cjs'))\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.CLAUDE_PROJECT_DIR || process.cwd(), '.claude', 'hooks', 'protect-sensitive-paths.cjs'))\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.CLAUDE_PROJECT_DIR || process.cwd(), '.claude', 'hooks', 'git-push-advisory.cjs'))\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.CLAUDE_PROJECT_DIR || process.cwd(), '.claude', 'hooks', 'fast-feedback.cjs'))\"",
            "timeout": 45
          }
        ]
      }
    ]
  }
}
