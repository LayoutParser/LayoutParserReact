# Ambiente: development | test | production
NODE_ENV=development

# Rede: o padrão é deliberadamente restrito ao loopback.
BFF_HOST=127.0.0.1
BFF_PORT=3100
BFF_PUBLIC_ORIGIN=http://localhost:3000
LAYOUTPARSER_API_URL=http://127.0.0.1:5000

# Microsoft Entra OIDC. Opcional no desenvolvimento com impersonação; obrigatório em produção.
# O secret nunca deve ser versionado. A URI registrada será BFF_PUBLIC_ORIGIN/auth/callback.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Google OAuth/OIDC. Provedor ALTERNATIVO ao Entra (o usuário escolhe um dos dois na tela de
# login) — opcional em qualquer ambiente, inclusive produção. Sem restrição de domínio: qualquer
# conta @gmail.com ou Google Workspace pode logar. O secret nunca deve ser versionado. A URI
# registrada no Google Cloud Console será BFF_PUBLIC_ORIGIN/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

BFF_SESSION_TTL_SECONDS=28800

# 32 MiB para a requisição HTTP completa; 25 MiB para o documento txtFile.
BFF_REQUEST_LIMIT_MIB=32
BFF_DOCUMENT_LIMIT_MIB=25
BFF_DOCUMENT_FIELD=txtFile

# Rate limiting em memória por identidade autenticada ou IP.
BFF_RATE_LIMIT_MAX=120
BFF_RATE_LIMIT_WINDOW_MS=60000

# Headers de identidade que o BFF injeta na chamada à API após validar a sessão.
BFF_TRUSTED_USER_HEADER=
BFF_TRUSTED_ROLES_HEADER=
# Identidade imutável usada pela API para resolver o UserId interno e os workspaces. O BFF remove
# valores recebidos do navegador e injeta apenas os dados da sessão OIDC validada.
BFF_TRUSTED_IDENTITY_PROVIDER_HEADER=
BFF_TRUSTED_IDENTITY_SUBJECT_HEADER=
BFF_TRUSTED_IDENTITY_TENANT_HEADER=

# Allowlist administrativa. Informe usuários e/ou grupos reais; não há credenciais padrão.
BFF_ADMIN_USERS=
BFF_ADMIN_ROLES=
BFF_ADMIN_PATHS=/api/monitoring/*,/api/ai-metrics/*,/api/layoutdatabase/refresh-cache,/api/metrics

# Impersonação local explícita. É proibida quando NODE_ENV=production.
BFF_DEV_AUTH_ENABLED=true
BFF_DEV_USER_HEADER=x-dev-user
BFF_DEV_ROLES_HEADER=x-dev-roles

BFF_LOG_LEVEL=info

# Servidores DNS fixos (IPs, separados por vírgula), opcional. Contorna a resolução multi-homed
# lenta do SO em hosts com múltiplas interfaces de rede ativas (ex.: ~11s de atraso resolvendo
# login.microsoftonline.com em BRNDDAPPBLD01). Deixe vazio para manter o comportamento padrão do
# Node/SO — só configure em hosts confirmadamente afetados.
BFF_DNS_SERVERS=
