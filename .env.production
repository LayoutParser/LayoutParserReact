# Carregado automaticamente pelo Vite em `npm run build` e `npm run build:prod` (modo production).

# Produção usa mesma origem: o navegador chama `/api` no mesmo host HTTPS que serviu o front.
# O IIS encaminha a chamada para o gateway Node em loopback; nenhum IP/porta interno entra no
# bundle e não há dependência de CORS. Deixe vazio para preservar esse comportamento.
VITE_API_BASE_URL=

# Limite de UX do arquivo de documento. A validação autoritativa continua no gateway/API.
VITE_MAX_UPLOAD_MB=25
